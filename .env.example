# Application Settings
PROJECT_NAME="News Bias and Framing Analysis System"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Database Settings (PostgreSQL)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
# If 5432 is already used by a local PostgreSQL service, set POSTGRES_PORT=5433
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=news_bias_db
DATABASE_URL="postgresql+psycopg://postgres:postgrespassword@localhost:5432/news_bias_db"

# Optional SQLite URL for quick local testing without PostgreSQL:
# DATABASE_URL="sqlite:///./news_bias.db"

# Embedding Pipeline Configuration
# Provider: 'sentence-transformers' (recommended default), 'openai', 'gemini', or 'mock' (tests only)
EMBEDDING_PROVIDER="sentence-transformers"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
EMBEDDING_DIMENSIONS=384
EMBEDDING_API_KEY=""
EMBEDDING_BATCH_SIZE=20

# Vector Database (Qdrant) Configuration
# Use QDRANT_PATH for persistent local file-backed storage:
QDRANT_PATH="./qdrant_data"
# Leave QDRANT_URL empty to use QDRANT_PATH or QDRANT_HOST:QDRANT_PORT (default: localhost:6333)
# To use in-memory mode without running Qdrant Docker or writing to disk, set QDRANT_URL=":memory:"
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="article_embeddings"
QDRANT_DISTANCE="Cosine"
QDRANT_TIMEOUT_SECONDS=10.0

# News Bias and Framing Analysis System - Environment Configuration
# Copy this file to .env and change the values for your computer.
#
# WARNING: every VITE_ variable is built into the browser code and anyone can
# read it. Never put passwords, database URLs or API keys here.

# Address of the FastAPI backend (no "/" at the end). For a deployed
# backend use its public address, e.g. https://api.example.org
# These values are built into the app: run "npm run build" again after a change.
VITE_API_BASE_URL=http://localhost:8000

# Path before /sources and /articles. The backend serves every route under
# both /api and /api/v1, so either works.
VITE_API_PREFIX=/api

# true  = show sample (mock) data, no backend needed for Articles and Sources
# false = call the real backend (default)
VITE_USE_MOCK_DATA=false
